<?xml version="1.0" encoding="utf-8"?>
<!-- Clock page on the all-in-one widget: same views as the Clock widget, a little more compact. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/clock_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp" />

                <TextClock
                    android:id="@+id/clock_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="monospace"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#FF8A8A8A"
                    android:textSize="12sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/clock_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFEBEBEB"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/clock_aqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FF8A8A8A"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/clock_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="NO ALARM"
                android:textColor="#FF8A8A8A"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/clock_sky"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Sun or moon now"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <ImageView
        android:id="@+id/clock_graph"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:contentDescription="Today's sun path"
        android:scaleType="fitXY" />
</LinearLayout>
