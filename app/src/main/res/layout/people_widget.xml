<?xml version="1.0" encoding="utf-8"?>
<!--
  People widget: header, a looping scene (frames and a travelling heart, both animated by the
  launcher itself, so the animation costs the app nothing), then the distance line and an
  action button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/people_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Tap: next group (when there's more than one), otherwise open the app. -->
    <LinearLayout
        android:id="@+id/people_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/people_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="US"
            android:textColor="#FF969696"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/people_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text=""
            android:textColor="#FF969696"
            android:textSize="10sp" />
    </LinearLayout>

    <!--
      The scene. Bottom layer: the avatars, a few frames the launcher cross-fades. Top layer:
      the heart / plane that travels between two people who are apart, moved by a view animation
      so it glides instead of jumping between frames. Only one of the two top flippers is shown.
    -->
    <FrameLayout
        android:id="@+id/people_scene"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <ViewFlipper
            android:id="@+id/people_frames"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="400"
            android:inAnimation="@anim/people_frame_in"
            android:outAnimation="@anim/people_frame_hold" />

        <!-- Travels from one end of its own width to the other (CITY, FAR). Sized in code. -->
        <ViewFlipper
            android:id="@+id/people_fly_go"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:autoStart="true"
            android:clipChildren="false"
            android:flipInterval="2400"
            android:inAnimation="@anim/people_fly_go"
            android:visibility="gone" />

        <!-- Sways around its own middle (NEAR). Sized in code. -->
        <ViewFlipper
            android:id="@+id/people_fly_sway"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:autoStart="true"
            android:clipChildren="false"
            android:flipInterval="2400"
            android:inAnimation="@anim/people_fly_sway"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Widgets only allow certain view classes; a plain View breaks the whole widget. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="#FF202020" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/people_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/people_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/people_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FF969696"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/people_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_pink"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
