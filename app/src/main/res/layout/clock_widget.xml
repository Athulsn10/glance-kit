<?xml version="1.0" encoding="utf-8"?>
<!--
  Clock widget: live time (TextClock, ticks on its own for free), date, next alarm, the sun or
  moon as it is right now, and today's sun path with sunrise and sunset marked.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/clock_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="46sp" />

                <TextClock
                    android:id="@+id/clock_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="monospace"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#FF8A8A8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:maxLines="1"
                android:textColor="#FFBDBDBD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/clock_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="NO ALARM"
                android:textColor="#FF8A8A8A"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/clock_sky"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Sun or moon now"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <ImageView
        android:id="@+id/clock_graph"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Today's sun path"
        android:scaleType="fitXY" />
</LinearLayout>
