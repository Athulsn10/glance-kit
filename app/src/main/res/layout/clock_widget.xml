<?xml version="1.0" encoding="utf-8"?>
<!--
  Clock widget (1.23 redesign, "concept E"): no card, it sits straight on the wallpaper like the
  phone's own clock. Date, a big live time (TextClock, ticks on its own), then four round dials:
  the sun in its real colour or tonight's moon, temperature, air quality and the next alarm.
  Sizes and colours are set from ClockViews at draw time (widget size, light or dark wallpaper).
  Only views allowed in RemoteViews: LinearLayout, FrameLayout, TextView, TextClock, ImageView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ck_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ck_time_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/ck_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:letterSpacing="0.09"
            android:maxLines="1"
            android:shadowColor="#59000000"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="#FFFFB547"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- The time row: replaced at draw time by clock_time_<font>.xml for the chosen font. -->
        <LinearLayout
            android:id="@+id/ck_time_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/clock_time_outfit" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ck_dials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ck_sky_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ck_sky"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Sun or moon now"
                android:src="@drawable/clock_dial_empty" />

            <TextView
                android:id="@+id/ck_sky_cap"
                style="@style/ClockCaption" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ck_temp_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ck_temp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Temperature"
                android:src="@drawable/clock_dial_empty" />

            <TextView
                android:id="@+id/ck_temp_cap"
                style="@style/ClockCaption" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ck_air_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ck_air"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Air quality"
                android:src="@drawable/clock_dial_empty" />

            <TextView
                android:id="@+id/ck_air_cap"
                style="@style/ClockCaption" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ck_alarm_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ck_alarm"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Next alarm"
                android:src="@drawable/clock_dial_empty" />

            <TextView
                android:id="@+id/ck_alarm_cap"
                style="@style/ClockCaption"
                android:text="ALARM" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
