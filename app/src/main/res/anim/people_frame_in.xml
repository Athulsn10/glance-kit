<?xml version="1.0" encoding="utf-8"?>
<!-- People widget: the next frame fades in over the one before it. The avatars are drawn in the
     same place in every frame, so only what differs (a blink, a heart) is seen to change. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:fromAlpha="0.0"
    android:interpolator="@android:anim/linear_interpolator"
    android:toAlpha="1.0" />
