<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget background "G1 smoked glass": a see-through dark layer with a hairline edge.
     Widgets can't blur what's behind them, so this is a tint, not a real blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#9E1C1D1D" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
