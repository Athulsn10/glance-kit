<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional: full-day data totals. The widget works without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Steps page: reads the phone's step counter. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Network type and speed estimate on the Data tab (granted automatically). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live compass widget: a small foreground service while the screen is on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional, asked only when you tap Clear cache: lets the app open Android's
         "clear app cache" dialog, which clears every app's cache in shared storage. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Lets the Phone tab show names and icons of your most-used apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Finds the phone's Clock app, so tapping the time opens it. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>
    <!-- Approximate location (never GPS) for sunrise, sunset, weather and air quality. Optional. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Weather for the Clock widget (MET Norway). Nothing else uses the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Short buzz when a focus session ends. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon: Compass, Level, Barometer. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Full-screen focus timer. -->
        <activity
            android:name=".FocusActivity"
            android:exported="false"
            android:label="Focus"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Live instruments. Sensors run only while this screen is open. -->
        <activity
            android:name=".InstrumentsActivity"
            android:exported="true"
            android:label="Instruments"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <receiver
            android:name=".RingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_glass_ring">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ring_widget_info" />
        </receiver>

        <service
            android:name=".CompassService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the home screen compass widget pointing north while the screen is on" />
        </service>

        <!-- Separate widgets, one per item. -->
        <receiver
            android:name=".ClockWidget"
            android:exported="true"
            android:label="@string/w_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Redraw when an alarm is set, changed or dismissed. -->
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_clock" />
        </receiver>
        <receiver
            android:name=".TodayWidget"
            android:exported="true"
            android:label="@string/w_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_today" />
        </receiver>

        <receiver
            android:name=".StepsWidget"
            android:exported="true"
            android:label="@string/w_steps">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_steps" />
        </receiver>

        <receiver
            android:name=".BatteryWidget"
            android:exported="true"
            android:label="@string/w_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_battery" />
        </receiver>

        <receiver
            android:name=".DataWidget"
            android:exported="true"
            android:label="@string/w_data">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_data" />
        </receiver>

        <receiver
            android:name=".FocusWidget"
            android:exported="true"
            android:label="@string/w_focus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_focus" />
        </receiver>

        <receiver
            android:name=".PressureWidget"
            android:exported="true"
            android:label="@string/w_pressure">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_pressure" />
        </receiver>

        <receiver
            android:name=".CompassWidget"
            android:exported="true"
            android:label="@string/w_compass">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_compass" />
        </receiver>
    </application>
</manifest>
